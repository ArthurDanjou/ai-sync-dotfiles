{
  "name": "dotfiles",
  "displayName": "Dotfiles",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Mac dotfiles with MCP server exporter for Zed, OpenCode, Claude Desktop, Claude Code, and LM Studio",
  "license": "MIT",
  "scripts": {
    "build": "tsx scripts/index.ts",
    "setup": "tsx scripts/dotfiles.ts",
    "install:all": "tsx scripts/install.ts",
    "install:zed": "tsx scripts/install.ts zed",
    "install:claude": "tsx scripts/install.ts claude",
    "install:claude-code": "tsx scripts/install.ts claudeCode",
    "install:opencode": "tsx scripts/install.ts opencode",
    "install:lmstudio": "tsx scripts/install.ts lmstudio",
    "audit": "tsx scripts/audit.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run build && bun run typecheck && bun run audit"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
